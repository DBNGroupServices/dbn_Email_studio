<?xml version="1.0" encoding="UTF-8"?>
<!-- DBN Email Studio 2.0 — Outlook add-in manifest (XML / add-in only manifest).
     Pages are served by the DBN Email Studio engine on this computer (https://localhost:8788).
     The engine must be running for the pane to load: the installer enables "start at sign-in". -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>7877fe62-01f2-4af8-b073-dfa805099a63</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>DBN</ProviderName>
  <DefaultLocale>en-AU</DefaultLocale>
  <DisplayName DefaultValue="DBN Email Studio"/>
  <Description DefaultValue="Reply in your own voice, rewrite, summarise and proofread emails using DBN Email Studio on this computer."/>
  <IconUrl DefaultValue="https://localhost:8788/icons/email-blue-v2-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:8788/icons/email-blue-v2-128.png"/>
  <SupportUrl DefaultValue="https://localhost:8788/office/help.html"/>
  <AppDomains>
    <AppDomain>https://localhost:8788</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:8788/office/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="DBN.Read.Group">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="DBN.Read.Open">
                  <Label resid="Button.Label"/>
                  <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Pane.Url"/></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="DBN.Compose.Group">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="DBN.Compose.Open">
                  <Label resid="Button.Label"/>
                  <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Pane.Url"/></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://localhost:8788/icons/email-blue-v2-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://localhost:8788/icons/email-blue-v2-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://localhost:8788/icons/email-blue-v2-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://localhost:8788/office/commands.html"/>
          <bt:Url id="Pane.Url" DefaultValue="https://localhost:8788/office/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="DBN Email Studio"/>
          <bt:String id="Button.Label" DefaultValue="Email Studio"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Description" DefaultValue="Draft a reply in your voice, rewrite, summarise or proofread the current email. Pin the pane to keep it open as you move between emails."/>
        </bt:LongStrings>
      </Resources>
    <!-- Mailbox 1.5+ (current Outlook Classic): pinnable pane that follows the selected email. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="DBN.Read.Group">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="DBN.Read.Open">
                  <Label resid="Button.Label"/>
                  <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Pane.Url"/><SupportsPinning>true</SupportsPinning></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="DBN.Compose.Group">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="DBN.Compose.Open">
                  <Label resid="Button.Label"/>
                  <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Pane.Url"/></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://localhost:8788/icons/email-blue-v2-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://localhost:8788/icons/email-blue-v2-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://localhost:8788/icons/email-blue-v2-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://localhost:8788/office/commands.html"/>
          <bt:Url id="Pane.Url" DefaultValue="https://localhost:8788/office/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="DBN Email Studio"/>
          <bt:String id="Button.Label" DefaultValue="Email Studio"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Description" DefaultValue="Draft a reply in your voice, rewrite, summarise or proofread the current email. Pin the pane to keep it open as you move between emails."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
